{
  "entities": {
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Öffentliches Stammesprofil eines Spielers ohne sensible Daten.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tribeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28
        },
        "bonfireLevel": {
          "type": "integer"
        },
        "power": {
          "type": "integer"
        },
        "tileX": {
          "type": "integer"
        },
        "tileY": {
          "type": "integer"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "tribeName", "bonfireLevel", "power", "tileX", "tileY", "updatedAt"]
    },
    "PrivateSave": {
      "title": "PrivateSave",
      "description": "Privater Spielstand eines Spielers (nur für den Eigentümer les- und schreibbar).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "tribeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28
        },
        "state": {
          "type": "object"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "schemaVersion", "tribeName", "state", "updatedAt"]
    },
    "WorldSettlement": {
      "title": "WorldSettlement",
      "description": "Sichtbare 2x2-Siedlung eines Spielers auf der gemeinsamen Multiplayer-Weltkarte.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tribeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28
        },
        "bonfireLevel": {
          "type": "integer"
        },
        "power": {
          "type": "integer"
        },
        "tileX": {
          "type": "integer"
        },
        "tileY": {
          "type": "integer"
        },
        "chunkKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 16,
          "pattern": "^[0-9]+_[0-9]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "tribeName", "bonfireLevel", "power", "tileX", "tileY", "chunkKey", "updatedAt"]
    },
    "WorldMarch": {
      "title": "WorldMarch",
      "description": "Aktiver Marsch eines Spielers auf der gemeinsamen Weltkarte.",
      "type": "object",
      "properties": {
        "marchId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tribeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28
        },
        "kind": {
          "type": "string",
          "enum": ["gather", "hunt"]
        },
        "fromX": {
          "type": "number"
        },
        "fromY": {
          "type": "number"
        },
        "toX": {
          "type": "number"
        },
        "toY": {
          "type": "number"
        },
        "targetLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["active", "completed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["marchId", "uid", "tribeName", "kind", "fromX", "fromY", "toX", "toY", "targetLabel", "status", "createdAt", "updatedAt"]
    },
    "WorldChatMessage": {
      "title": "WorldChatMessage",
      "description": "Nachricht im globalen Welt-Chat der gemeinsamen Dinosaurierwelt.",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tribeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28
        },
        "bonfireLevel": {
          "type": "integer"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "channel": {
          "type": "string",
          "enum": ["world"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["messageId", "uid", "tribeName", "bonfireLevel", "text", "channel", "createdAt"]
    },
    "WorldTrade": {
      "title": "WorldTrade",
      "description": "Zweiseitiges Ressourcen-Tauschangebot zwischen zwei Stämmen mit doppelter Bestätigung (fromConfirmed & toConfirmed).",
      "type": "object",
      "properties": {
        "tradeId": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fromTribeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28
        },
        "toUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "toTribeName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 28
        },
        "offerResource": {
          "type": "string",
          "enum": ["meat", "wood", "stone", "fur"]
        },
        "offerAmount": {
          "type": "integer"
        },
        "requestResource": {
          "type": "string",
          "enum": ["meat", "wood", "stone", "fur"]
        },
        "requestAmount": {
          "type": "integer"
        },
        "fromConfirmed": {
          "type": "boolean"
        },
        "toConfirmed": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "completed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tradeId",
        "fromUid",
        "fromTribeName",
        "toUid",
        "toTribeName",
        "offerResource",
        "offerAmount",
        "requestResource",
        "requestAmount",
        "fromConfirmed",
        "toConfirmed",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}/public/profile": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Öffentliches Stammesprofil eines Spielers."
    },
    "/users/{userId}/private/save": {
      "schema": { "$ref": "#/entities/PrivateSave" },
      "description": "Privater, vollständiger Spielstand eines Spielers."
    },
    "/world_settlements/{userId}": {
      "schema": { "$ref": "#/entities/WorldSettlement" },
      "description": "Alle Spielerdörfer auf dem gemeinsamen 1200x1200-Weltkartenraster."
    },
    "/world_marches/{marchId}": {
      "schema": { "$ref": "#/entities/WorldMarch" },
      "description": "Aktive Weltkarten-Märsche aller Spieler."
    },
    "/world_chat/{messageId}": {
      "schema": { "$ref": "#/entities/WorldChatMessage" },
      "description": "Globaler Echtzeit-Welt-Chat."
    },
    "/world_trades/{tradeId}": {
      "schema": { "$ref": "#/entities/WorldTrade" },
      "description": "Zweiseitige Ressourcen-Tauschangebote mit beidseitiger Bestätigung."
    }
  }
}
