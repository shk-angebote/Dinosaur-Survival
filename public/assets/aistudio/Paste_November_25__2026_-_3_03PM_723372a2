      document.getElementById('pvpPaintCount').innerText = pvpPaint;
      document.getElementById('pvePaintCount').innerText = pvePaint;
      if (document.getElementById('heroModal').classList.contains('opacity-100')) {
        renderHeroModal(selectedHeroId);
      }
    }

