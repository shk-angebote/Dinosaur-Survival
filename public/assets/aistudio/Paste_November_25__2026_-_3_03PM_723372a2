      const container = document.getElementById('heroesGrid');
      const list = getFilteredHeroes();

      if (list.length === 0) {
        container.innerHTML = `
          <div class="col-span-2 text-center py-10 text-neutral-500 text-xs">
            Keine Helden für diesen Filter gefunden.
          </div>
        `;
        return;
      }

      container.innerHTML = list.map(hero => {
        let borderClass = 'border-amber-500/60 shadow-glow-gold bg-gradient-to-b from-amber-950/30 to-volcano-900';
        let rarityLabel = 'Gold';
        let rarityTextClass = 'text-amber-400';

        if (hero.rarity === 'purple') {
          borderClass = 'border-purple-500/60 shadow-glow-epic bg-gradient-to-b from-purple-950/30 to-volcano-900';
          rarityLabel = 'Lila';
          rarityTextClass = 'text-purple-400';
        } else if (hero.rarity === 'blue') {
          borderClass = 'border-blue-500/60 shadow-glow-rare bg-gradient-to-b from-blue-950/30 to-volcano-900';
          rarityLabel = 'Blau (Sammler)';
          rarityTextClass = 'text-blue-400';
        }

        return `
          <div onclick="openHeroModal('${hero.id}')" class="relative group cursor-pointer p-2.5 rounded-2xl border ${borderClass} emboss-stone hover:scale-[1.02] active:scale-[0.98] transition-all flex flex-col justify-between">
            
            <!-- Top Card Header: Class Icon + S0 Badge -->
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-1 bg-volcano-950/80 px-1.5 py-0.5 rounded-md border border-neutral-700 text-[10px]">
                <span>${hero.roleIcon}</span>
                <span class="font-bold text-neutral-300">${hero.role === 'melee' ? 'Nah' : hero.role === 'tank' ? 'Tank' : 'Fern'}</span>
              </div>
              <div class="flex items-center gap-1">
                <span class="text-[9px] font-black px-1 rounded bg-black/60 ${rarityTextClass}">${hero.rarity.toUpperCase()}</span>
                <span class="badge-s0 text-[9px] font-black px-1.5 py-0.2 rounded text-white shadow">S0</span>
              </div>
            </div>

            <!-- Central Hero Portrait / Visual Element -->
            <div class="py-2.5 flex flex-col items-center justify-center">
              <div class="w-14 h-14 rounded-2xl bg-gradient-to-b from-volcano-700 to-volcano-950 border border-volcano-600 flex items-center justify-center text-3xl shadow-inner group-hover:scale-105 transition-transform">
                ${hero.avatarIcon}
              </div>
              <div class="mt-1.5 text-center px-1">
                <div class="font-bold text-xs text-white truncate max-w-[140px]">${hero.name}</div>
                <div class="text-[9px] text-neutral-400 truncate max-w-[130px]">${hero.title}</div>
              </div>
            </div>

            <!-- Bottom Stats: Level, Power, 6-Stars Row -->
            <div class="pt-1.5 border-t border-volcano-700/60 space-y-1">
              <div class="flex items-center justify-between text-[10px]">
                <span class="font-black text-amber-200">Lv. ${hero.level}</span>
                <span class="font-bold text-amber-400">⚡ ${(hero.power / 1000).toFixed(1)}k</span>
