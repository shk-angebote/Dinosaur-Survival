    // --- CORNER UPGRADE LOGIC (5 Corners = 1 Full Star) ---
    function upgradeCurrentHeroCorner() {
      const hero = heroesData.find(h => h.id === selectedHeroId);
      if (!hero || hero.stars >= 6) return;

      hero.corners++;
      hero.power += 850;

      if (hero.corners >= 5) {
        hero.stars++;
        hero.corners = 0;
        hero.power += 3500;
        showToast(`HERRVOLL! ${hero.name} hat Stern ${hero.stars} erreicht!`, '🌟');
      } else {
        showToast(`${hero.name}: Ecke ${hero.corners}/5 entzündet!`, '⭐');
      }

      renderHeroModal(hero.id);
      renderHeroes();
    }

