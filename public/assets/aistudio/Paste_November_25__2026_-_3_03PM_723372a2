      }
    }

    // --- 5-POINT STAR SVG GENERATOR WITH CORNER PROGRESS ---
    // Each star has 5 corners. We visually color the corners based on completed corners.
    function generateStarSvg(isFullStar, activeCornersForThisStar, size = 16) {
      // 5-point star path points
      const points = "12,2 15,9 22,9 16.5,14 18.5,21 12,17 5.5,21 7.5,14 2,9 9,9";
      
      let fillColor = '#372725'; // empty
      let strokeColor = '#5c3d39';

      if (isFullStar) {
        fillColor = '#fbbf24'; // fully lit gold star
        strokeColor = '#b45309';
      } else if (activeCornersForThisStar > 0) {
        // Star in progress: shows glowing ember partial color
        fillColor = '#ea580c';
        strokeColor = '#f97316';
      }

      return `
        <div class="relative inline-flex items-center justify-center">
          <svg width="${size}" height="${size}" viewBox="0 0 24 24" class="drop-shadow">
            <polygon points="${points}" fill="${fillColor}" stroke="${strokeColor}" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          ${!isFullStar && activeCornersForThisStar > 0 ? `
            <span class="absolute -bottom-1 -right-1 text-[8px] bg-volcano-950 px-1 rounded-full text-amber-300 font-black border border-amber-500/60 leading-tight">
              ${activeCornersForThisStar}
            </span>
          ` : ''}
        </div>
      `;
    }

    function renderStarRow(stars, corners, size = 14) {
      let html = '';
      for (let s = 1; s <= 6; s++) {
        if (s <= stars) {
          html += generateStarSvg(true, 5, size);
        } else if (s === stars + 1 && corners > 0) {
          html += generateStarSvg(false, corners, size);
        } else {
          html += generateStarSvg(false, 0, size);
        }
      }
      return html;
    }

    // --- FILTER & SORT LOGIC ---
    function setFilter(filterType) {
      currentFilter = filterType;
      document.querySelectorAll('.tab-btn').forEach(btn => {
        const f = btn.getAttribute('data-filter');
        if (f === filterType) {
          btn.className = 'tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-amber-500/20 text-amber-300 border-amber-500/50';
        } else {
          btn.className = 'tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-volcano-800 text-neutral-300 border-transparent hover:border-neutral-600';
        }
      });
      renderHeroes();
    }

    function getFilteredHeroes() {
      let list = [...heroesData];
      if (currentFilter === 'gold') list = list.filter(h => h.rarity === 'gold');
      if (currentFilter === 'purple') list = list.filter(h => h.rarity === 'purple');
      if (currentFilter === 'blue') list = list.filter(h => h.rarity === 'blue');
      if (currentFilter === 'melee') list = list.filter(h => h.role === 'melee');
      if (currentFilter === 'tank') list = list.filter(h => h.role === 'tank');
      if (currentFilter === 'ranged') list = list.filter(h => h.role === 'ranged');

      const sortVal = document.getElementById('sortSelect').value;
      if (sortVal === 'power') list.sort((a, b) => b.power - a.power);
      if (sortVal === 'level') list.sort((a, b) => b.level - a.level);
      if (sortVal === 'stars') list.sort((a, b) => (b.stars * 5 + b.corners) - (a.stars * 5 + a.corners));
      return list;
    }

