<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Dino Survival - Heldenlager S0</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['Plus Jakarta Sans', 'sans-serif'],
            title: ['Cinzel', 'serif'],
          },
          colors: {
            volcano: {
              900: '#110c0c',
              850: '#181212',
              800: '#231818',
              700: '#342222',
              600: '#4c2e2c',
              lava: '#ff5e1a',
              amber: '#ffaa29',
              gold: '#f59e0b',
              epic: '#a855f7',
              rare: '#3b82f6',
            }
          },
          boxShadow: {
            'glow-lava': '0 0 20px rgba(255, 94, 26, 0.45)',
            'glow-gold': '0 0 16px rgba(245, 158, 11, 0.35)',
            'glow-epic': '0 0 16px rgba(168, 85, 247, 0.35)',
            'glow-rare': '0 0 16px rgba(59, 130, 246, 0.35)',
          }
        }
      }
    }
  </script>
  <style>
    body {
      background: #090707;
      color: #e5e7eb;
      font-family: 'Plus Jakarta Sans', sans-serif;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: #442a27;
      border-radius: 9999px;
    }
    .emboss-stone {
      background: linear-gradient(180deg, #2b1f1e 0%, #171111 100%);
      border: 1px solid #4a3431;
      box-shadow: inset 0 1px 0 rgba(255,255,255,0.08), 0 4px 10px rgba(0,0,0,0.6);
    }
    .badge-s0 {
      background: linear-gradient(135deg, #d97706, #b45309);
      text-shadow: 0 1px 2px rgba(0,0,0,0.8);
    }
  </style>
</head>
<body class="flex items-center justify-center min-h-screen p-0 sm:p-4 bg-neutral-950">

  <!-- Mobile Viewport Frame (9:16 Aspect feel) -->
  <div class="relative w-full max-w-[440px] h-[100dvh] sm:h-[900px] bg-volcano-900 border-0 sm:border border-volcano-700/60 sm:rounded-[32px] overflow-hidden flex flex-col shadow-2xl shadow-black">
    
    <!-- Toast Notification Message Box -->
    <div id="toastBox" class="absolute top-16 left-1/2 -translate-x-1/2 z-50 pointer-events-none transition-all duration-300 opacity-0 transform -translate-y-4 px-4 py-2 rounded-xl text-xs font-bold text-white shadow-xl flex items-center gap-2 border bg-volcano-800/95 border-amber-500/50 backdrop-blur-md">
      <span id="toastIcon">✨</span>
      <span id="toastMsg">Hinweis</span>
    </div>

    <!-- TOP HEADER BAR -->
    <header class="relative z-20 shrink-0 px-4 pt-3 pb-2.5 bg-gradient-to-b from-volcano-850 to-volcano-900/95 border-b border-volcano-700/60 backdrop-blur-md">
      <div class="flex items-center justify-between">
        <!-- Title & S0 Tag -->
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-volcano-700 to-volcano-850 border border-volcano-600 flex items-center justify-center text-amber-400 font-bold text-sm shadow-md">
            🦖
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h1 class="font-title text-base font-black text-amber-100 tracking-wider">HELDEN</h1>
              <span class="badge-s0 text-[10px] font-extrabold px-1.5 py-0.5 rounded text-white shadow">S0</span>
            </div>
            <p class="text-[10px] text-neutral-400 leading-none">Aschewüste & Urzeit-Survival</p>
          </div>
        </div>

        <!-- Signalfeuer Simulation Widget (Testing Tool) -->
        <div class="flex items-center gap-1.5 bg-volcano-800/90 border border-amber-500/30 px-2 py-1 rounded-xl shadow-inner">
          <div class="flex flex-col items-end">
            <span class="text-[9px] uppercase tracking-wider text-amber-300/80 font-bold">Signalfeuer</span>
            <span id="signalfeuerBadge" class="text-xs font-black text-amber-400">St. 10</span>
          </div>
          <div class="flex flex-col gap-0.5 ml-1">
            <button onclick="changeSignalfeuer(1)" class="w-4 h-4 bg-volcano-700 hover:bg-amber-600 text-[10px] rounded flex items-center justify-center text-white font-bold leading-none active:scale-95 transition-all">▲</button>
            <button onclick="changeSignalfeuer(-1)" class="w-4 h-4 bg-volcano-700 hover:bg-amber-600 text-[10px] rounded flex items-center justify-center text-white font-bold leading-none active:scale-95 transition-all">▼</button>
          </div>
        </div>
      </div>

      <!-- Inventory Resources (PvP-Malerei & PvE-Malerei) -->
      <div class="mt-2.5 grid grid-cols-2 gap-2">
        <!-- PvP Malerei -->
        <div class="bg-gradient-to-r from-red-950/60 to-volcano-800/80 border border-red-500/30 rounded-xl p-1.5 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <div class="w-7 h-7 rounded-lg bg-red-900/60 border border-red-500/40 flex items-center justify-center text-sm shadow">
              🩸
            </div>
            <div>
              <div class="text-[9px] font-semibold text-red-300 leading-none">PvP-Malerei</div>
              <div id="pvpPaintCount" class="text-xs font-black text-red-100">18</div>
            </div>
          </div>
          <button onclick="addPaint('pvp', 6, 'Heldenhöhle')" title="Aus Heldenhöhle plündern" class="px-2 py-1 bg-red-600/80 hover:bg-red-500 rounded-lg text-[10px] font-bold text-white shadow active:scale-95 transition-all">
            +6 Höhle
          </button>
        </div>

        <!-- PvE Malerei -->
        <div class="bg-gradient-to-r from-emerald-950/60 to-volcano-800/80 border border-emerald-500/30 rounded-xl p-1.5 flex items-center justify-between">
          <div class="flex items-center gap-1.5">
            <div class="w-7 h-7 rounded-lg bg-emerald-900/60 border border-emerald-500/40 flex items-center justify-center text-sm shadow">
              🌿
            </div>
            <div>
              <div class="text-[9px] font-semibold text-emerald-300 leading-none">PvE-Malerei</div>
              <div id="pvePaintCount" class="text-xs font-black text-emerald-100">22</div>
            </div>
          </div>
          <button onclick="addPaint('pve', 6, 'Wildnis')" title="In der Wildnis suchen" class="px-2 py-1 bg-emerald-600/80 hover:bg-emerald-500 rounded-lg text-[10px] font-bold text-white shadow active:scale-95 transition-all">
            +6 Wildnis
          </button>
        </div>
      </div>

      <!-- Quick Banner Info on Gear Unlock -->
      <div id="gearUnlockHeaderNote" class="mt-2 text-[10px] text-center font-medium rounded-lg py-1 px-2 border transition-all duration-300 bg-amber-950/30 border-amber-600/30 text-amber-200">
        <!-- dynamic text -->
      </div>
    </header>

    <!-- FILTER & SORT BAR -->
    <div class="shrink-0 px-3 py-2 bg-volcano-850/95 border-b border-volcano-700/40 flex items-center justify-between gap-2">
      <!-- Scrollable Tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5 custom-scrollbar text-xs">
        <button onclick="setFilter('all')" class="tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-amber-500/20 text-amber-300 border-amber-500/50" data-filter="all">Alle</button>
        <button onclick="setFilter('gold')" class="tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-volcano-800 text-yellow-400/80 border-transparent hover:border-yellow-500/40" data-filter="gold">Gold</button>
        <button onclick="setFilter('purple')" class="tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-volcano-800 text-purple-400/80 border-transparent hover:border-purple-500/40" data-filter="purple">Lila</button>
        <button onclick="setFilter('blue')" class="tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-volcano-800 text-blue-400/80 border-transparent hover:border-blue-500/40" data-filter="blue">Blau (Sammler)</button>
        <button onclick="setFilter('melee')" class="tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-volcano-800 text-neutral-300 border-transparent" data-filter="melee">Keulen</button>
        <button onclick="setFilter('tank')" class="tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-volcano-800 text-neutral-300 border-transparent" data-filter="tank">Dinoreiter</button>
        <button onclick="setFilter('ranged')" class="tab-btn px-2.5 py-1 rounded-lg font-bold border transition-all text-[11px] bg-volcano-800 text-neutral-300 border-transparent" data-filter="ranged">Schleuder</button>
      </div>

      <!-- Sort Dropdown -->
      <div class="shrink-0 flex items-center gap-1 text-[11px] bg-volcano-800 px-2 py-1 rounded-lg border border-volcano-600/50">
        <span class="text-neutral-400 text-[10px]">Sortieren:</span>
        <select id="sortSelect" onchange="renderHeroes()" class="bg-transparent text-amber-200 font-bold focus:outline-none cursor-pointer">
          <option value="power" class="bg-volcano-900 text-white">Macht</option>
          <option value="level" class="bg-volcano-900 text-white">Level</option>
          <option value="stars" class="bg-volcano-900 text-white">Sterne</option>
        </select>
      </div>
    </div>

    <!-- MAIN ROSTER GRID (SCROLLABLE AREA) -->
    <main class="flex-1 overflow-y-auto px-3 py-3 custom-scrollbar">
      <div id="heroesGrid" class="grid grid-cols-2 sm:grid-cols-2 gap-2.5">
        <!-- Rendered via JavaScript -->
      </div>
    </main>

    <!-- BOTTOM ACTION BAR (WHITEOUT SURVIVAL INSPIRED) -->
    <footer class="shrink-0 px-4 py-2.5 bg-volcano-850/95 border-t border-volcano-700/60 flex items-center justify-between gap-3">
      <button onclick="openCampModal()" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-blue-700 to-blue-600 hover:from-blue-600 hover:to-blue-500 border border-blue-400/50 text-white font-extrabold text-xs tracking-wide shadow-md flex items-center justify-center gap-1.5 active:scale-95 transition-all">
        <span>⛺</span> Trainingslager
      </button>
      <button onclick="recruitHero()" class="flex-1 py-2.5 rounded-xl bg-gradient-to-r from-amber-600 to-orange-500 hover:from-amber-500 hover:to-orange-400 border border-amber-300/60 text-white font-extrabold text-xs tracking-wide shadow-md shadow-amber-900/30 flex items-center justify-center gap-1.5 active:scale-95 transition-all">
        <span>🔥</span> Helden rekrutieren
      </button>
    </footer>

    <!-- HERO DETAIL MODAL (FULL OVERLAY) -->
    <div id="heroModal" class="absolute inset-0 z-40 bg-volcano-950/95 backdrop-blur-md flex flex-col transition-all duration-300 translate-y-full opacity-0 pointer-events-none">
      
      <!-- Modal Header -->
      <div class="shrink-0 px-4 pt-3 pb-2.5 border-b border-volcano-700/80 flex items-center justify-between bg-volcano-900">
        <button onclick="closeHeroModal()" class="w-8 h-8 rounded-lg bg-volcano-800 border border-volcano-600 flex items-center justify-center text-amber-200 hover:text-white font-bold text-sm active:scale-90 transition-all">
          ←
        </button>
        <div class="text-center">
          <span class="text-[10px] uppercase font-extrabold tracking-widest text-neutral-400">Helden-Details (S0)</span>
          <h2 id="modalHeroName" class="font-title text-base font-black text-amber-100 leading-tight">Name</h2>
        </div>
        <div id="modalRarityBadge" class="text-[10px] font-extrabold px-2 py-0.5 rounded uppercase border">
          Gold
        </div>
      </div>

      <!-- Modal Body (Scrollable) -->
      <div class="flex-1 overflow-y-auto px-4 py-3 custom-scrollbar space-y-3.5">
        
        <!-- Top Hero Card Overview -->
        <div id="modalHeaderCard" class="p-3 rounded-2xl border flex items-center gap-3 bg-gradient-to-r relative overflow-hidden">
          <div id="modalAvatarBox" class="w-16 h-16 rounded-xl border flex items-center justify-center text-3xl shadow-inner shrink-0 bg-volcano-900">
            🦖
          </div>
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-1">
              <span id="modalRoleLabel" class="text-xs font-black text-amber-300 truncate">Dinoreiter (Tank)</span>
              <span id="modalPowerVal" class="text-xs font-black text-amber-400">⚡ 124.200</span>
            </div>
            <p id="modalHeroTitle" class="text-[11px] text-neutral-400 truncate">Titel des Helden</p>

            <!-- Star Rating Display & Corner Progress -->
            <div class="mt-1 flex items-center justify-between">
              <div id="modalStarsDisplay" class="flex items-center gap-1">
                <!-- 6 SVG Stars with corners -->
              </div>
              <span id="modalCornerText" class="text-[10px] font-bold text-neutral-300">0/5 Ecken</span>
            </div>
          </div>
        </div>

        <!-- Star Upgrade Action Button (5 Corners = 1 Full Star up to 6 Stars) -->
        <div class="p-2.5 rounded-xl bg-volcano-850 border border-volcano-700 flex items-center justify-between gap-2">
          <div>
            <div class="text-[11px] font-extrabold text-white flex items-center gap-1">
              <span>⭐</span> Sternen-Aufstieg (Max. 6 Sterne)
            </div>
            <div class="text-[10px] text-neutral-400">Jeder Stern benötigt 5 Ecken.</div>
          </div>
          <button id="upgradeCornerBtn" onclick="upgradeCurrentHeroCorner()" class="px-3 py-1.5 rounded-lg bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-white font-extrabold text-xs shadow-md active:scale-95 transition-all flex items-center gap-1">
            <span>+1 Ecke</span>
          </button>
        </div>

        <!-- EQUIPMENT SECTION (SIGNALFEUER RULE: LEVEL 10 REQUIRED) -->
        <div class="p-3 rounded-2xl bg-volcano-850 border border-volcano-700/80">
          <div class="flex items-center justify-between mb-2">
            <div class="flex items-center gap-1.5">
              <span class="text-xs">🛡️</span>
              <h3 class="text-xs font-bold text-neutral-200 uppercase tracking-wide">Helden-Ausrüstung</h3>
            </div>
            <span id="equipmentStatusTag" class="text-[10px] font-extrabold px-2 py-0.5 rounded-full border">
              St. 10 benötigt
            </span>
          </div>

          <!-- Unlocked Gear Slots or Lock Overlay -->
          <div id="equipmentContainer" class="relative">
            <!-- 4 Slots: Waffe, Rüstung, Helm, Amulett -->
            <div class="grid grid-cols-4 gap-2" id="equipmentSlotsGrid">
              <!-- Rendered via JS -->
            </div>

            <!-- Lock Banner when Signalfeuer < 10 -->
            <div id="equipmentLockOverlay" class="absolute inset-0 bg-volcano-950/90 rounded-xl backdrop-blur-sm flex flex-col items-center justify-center p-2 text-center border border-red-500/30">
              <div class="text-xl mb-1">🔒</div>
              <div class="text-xs font-bold text-red-300">Ausrüstung gesperrt</div>
              <div class="text-[10px] text-neutral-400 mt-0.5">Wird ab <strong class="text-amber-400">Signalfeuer Stufe 10</strong> freigeschaltet!</div>
              <button onclick="boostSignalfeuerTo10()" class="mt-2 px-2.5 py-1 rounded bg-amber-600/80 hover:bg-amber-500 text-[10px] font-black text-white">
                Signalfeuer auf St. 10 setzen
              </button>
            </div>
          </div>
        </div>

        <!-- 6 SKILLS SECTION (3x PVP + 3x PVE) -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1">
              <span class="text-xs">🔥</span>
              <h3 class="text-xs font-black text-amber-200 uppercase tracking-wider">6 Fähigkeiten (Max. Lv. 6)</h3>
            </div>
            <span class="text-[10px] text-neutral-400">Heldenhöhle & Wildnis</span>
          </div>

          <!-- 3x PvP SKILLS -->
          <div class="p-3 rounded-2xl bg-red-950/20 border border-red-700/40">
            <div class="flex items-center justify-between mb-2 pb-1.5 border-b border-red-800/40">
              <span class="text-xs font-bold text-red-300 flex items-center gap-1">
                <span>⚔️</span> 3x PvP-Fähigkeiten
              </span>
              <span class="text-[10px] text-red-300/80 font-semibold">Bedarf: PvP-Malerei</span>
            </div>
            <div id="pvpSkillsContainer" class="space-y-2">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- 3x PvE DINO & WILDERNESS SKILLS -->
          <div class="p-3 rounded-2xl bg-emerald-950/20 border border-emerald-700/40">
            <div class="flex items-center justify-between mb-2 pb-1.5 border-b border-emerald-800/40">
              <span class="text-xs font-bold text-emerald-300 flex items-center gap-1">
                <span>🦖</span> 3x Dinojagd & Wildnis
              </span>
              <span class="text-[10px] text-emerald-300/80 font-semibold">Bedarf: PvE-Malerei</span>
            </div>
            <div id="pveSkillsContainer" class="space-y-2">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- INFO / TRAINING CAMP MODAL -->
    <div id="genericModal" class="absolute inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
      <div class="w-full max-w-xs bg-volcano-850 border border-amber-500/40 rounded-2xl p-4 shadow-2xl text-center space-y-3">
        <div id="genericModalIcon" class="text-3xl">⛺</div>
        <h3 id="genericModalTitle" class="text-sm font-bold text-amber-200">Trainingslager</h3>
        <p id="genericModalText" class="text-xs text-neutral-300 leading-relaxed">Alle deine S0-Einheiten werden hier gedrillt.</p>
        <button onclick="closeGenericModal()" class="w-full py-2 bg-volcano-700 hover:bg-volcano-600 rounded-xl text-xs font-bold text-white transition-all">
          Verstanden
        </button>
      </div>
    </div>

  </div>

