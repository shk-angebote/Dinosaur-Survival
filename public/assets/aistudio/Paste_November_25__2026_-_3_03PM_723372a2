        lockOverlay.classList.add('hidden');
      } else {
        statusTag.innerText = `Gesperrt (St. 10 nötig)`;
        statusTag.className = 'text-[10px] font-extrabold px-2 py-0.5 rounded-full border bg-red-950/60 border-red-500/50 text-red-300';
        lockOverlay.classList.remove('hidden');
      }

      const slots = [
        { key: 'waffe', label: 'Waffe' },
        { key: 'ruestung', label: 'Rüstung' },
        { key: 'helm', label: 'Helm' },
        { key: 'amulett', label: 'Amulett' }
      ];

      const grid = document.getElementById('equipmentSlotsGrid');
      grid.innerHTML = slots.map(s => {
        const item = hero.equipment[s.key];
        return `
          <div class="bg-volcano-900 border border-volcano-700 rounded-xl p-1.5 flex flex-col items-center text-center">
            <div class="w-8 h-8 rounded-lg bg-volcano-800 border border-amber-500/40 flex items-center justify-center text-base shadow mb-1">
              ${item.icon}
            </div>
            <div class="text-[9px] font-bold text-neutral-300 truncate w-full">${item.name}</div>
            <div class="text-[8px] font-semibold text-emerald-400 mt-0.5">${item.bonus}</div>
            <div class="text-[7px] text-neutral-500 uppercase mt-0.5">${s.label}</div>
          </div>
        `;
      }).join('');
    }

    // --- 6 SKILLS SYSTEM (LEVEL UP WITH MALEREI UP TO MAX LV. 6) ---
    function renderSkillsUI(hero) {
      const pvpContainer = document.getElementById('pvpSkillsContainer');
      const pveContainer = document.getElementById('pveSkillsContainer');

      // 3 PvP Skills
      pvpContainer.innerHTML = hero.skills.pvp.map(skill => {
        const cost = skill.level * 2; // e.g. Lv. 1->2 costs 2, Lv. 2->3 costs 4, etc.
        const isMax = skill.level >= 6;
        const canAfford = pvpPaint >= cost;

        return `
          <div class="p-2 rounded-xl bg-volcano-900/90 border border-red-900/40 flex items-center justify-between gap-2">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5">
                <span class="text-[11px] font-black text-white truncate">${skill.name}</span>
                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded ${isMax ? 'bg-amber-500 text-black' : 'bg-red-950 text-red-300 border border-red-600/40'}">
                  Lv. ${skill.level}/6
                </span>
              </div>
              <p class="text-[9.5px] text-neutral-300 mt-0.5 leading-snug">${skill.desc}</p>
              <div class="text-[8px] text-red-300/70 mt-0.5">Quelle: Heldenhöhle & Wildnis</div>
            </div>
            <div class="shrink-0 text-right">
              ${isMax ? `
                <span class="text-[10px] font-black text-amber-400">MAX</span>
              ` : `
                <button onclick="upgradeSkill('${hero.id}', 'pvp', '${skill.id}', ${cost})" ${canAfford ? '' : 'disabled'} class="px-2.5 py-1.5 rounded-lg text-[10px] font-extrabold shadow active:scale-95 transition-all flex flex-col items-center ${canAfford ? 'bg-red-600 hover:bg-red-500 text-white' : 'bg-neutral-800 text-neutral-500 cursor-not-allowed'}">
                  <span>Aufwerten</span>
                  <span class="text-[8px] opacity-90">${cost} PvP-Malerei</span>
                </button>
              `}
            </div>
          </div>
        `;
      }).join('');

      // 3 PvE Skills
      pveContainer.innerHTML = hero.skills.pve.map(skill => {
        const cost = skill.level * 2;
        const isMax = skill.level >= 6;
        const canAfford = pvePaint >= cost;

        return `
          <div class="p-2 rounded-xl bg-volcano-900/90 border border-emerald-900/40 flex items-center justify-between gap-2">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-1.5">
                <span class="text-[11px] font-black text-white truncate">${skill.name}</span>
                <span class="text-[9px] font-bold px-1.5 py-0.2 rounded ${isMax ? 'bg-amber-500 text-black' : 'bg-emerald-950 text-emerald-300 border border-emerald-600/40'}">
                  Lv. ${skill.level}/6
                </span>
              </div>
              <p class="text-[9.5px] text-neutral-300 mt-0.5 leading-snug">${skill.desc}</p>
              <div class="text-[8px] text-emerald-300/70 mt-0.5">Quelle: Heldenhöhle & Wildnis</div>
            </div>
            <div class="shrink-0 text-right">
              ${isMax ? `
                <span class="text-[10px] font-black text-amber-400">MAX</span>
              ` : `
                <button onclick="upgradeSkill('${hero.id}', 'pve', '${skill.id}', ${cost})" ${canAfford ? '' : 'disabled'} class="px-2.5 py-1.5 rounded-lg text-[10px] font-extrabold shadow active:scale-95 transition-all flex flex-col items-center ${canAfford ? 'bg-emerald-600 hover:bg-emerald-500 text-white' : 'bg-neutral-800 text-neutral-500 cursor-not-allowed'}">
                  <span>Aufwerten</span>
                  <span class="text-[8px] opacity-90">${cost} PvE-Malerei</span>
                </button>
              `}
            </div>
          </div>
        `;
      }).join('');
    }

    function upgradeSkill(heroId, type, skillId, cost) {
      const hero = heroesData.find(h => h.id === heroId);
      if (!hero) return;

      if (type === 'pvp') {
        if (pvpPaint < cost) {
          showToast('Nicht genug PvP-Malerei!', '⚠️');
          return;
        }
        const sk = hero.skills.pvp.find(s => s.id === skillId);
        if (sk && sk.level < 6) {
          pvpPaint -= cost;
          sk.level++;
          hero.power += 1200;
          showToast(`PvP-Skill '${sk.name}' auf Lv. ${sk.level} erhöht!`, '🩸');
        }
      } else {
        if (pvePaint < cost) {
          showToast('Nicht genug PvE-Malerei!', '⚠️');
          return;
        }
        const sk = hero.skills.pve.find(s => s.id === skillId);
        if (sk && sk.level < 6) {
          pvePaint -= cost;
          sk.level++;
          hero.power += 1200;
          showToast(`Dino-Skill '${sk.name}' auf Lv. ${sk.level} erhöht!`, '🌿');
        }
      }

      updateResourceUI();
      renderHeroModal(hero.id);
      renderHeroes();
    }

    // --- MODAL UTILITIES ---
    function openCampModal() {
      document.getElementById('genericModalIcon').innerText = '⛺';
      document.getElementById('genericModalTitle').innerText = 'Trainingslager (S0)';
      document.getElementById('genericModalText').innerText = 'Im Trainingslager drillst du Keulenschwinger, Dinoreiter und Steinschleuderer mit Asche-Erfahrung.';
      const m = document.getElementById('genericModal');
      m.classList.remove('opacity-0', 'pointer-events-none');
      m.classList.add('opacity-100');
    }

    function recruitHero() {
      const randomShards = Math.floor(Math.random() * 3) + 1;
      pvpPaint += 4;
      pvePaint += 4;
      updateResourceUI();
      document.getElementById('genericModalIcon').innerText = '🔥';
      document.getElementById('genericModalTitle').innerText = 'Helden-Beschwörung';
      document.getElementById('genericModalText').innerText = `Du hast das Urfeuer angerufen! Erhalten: +4 PvP-Malerei & +4 PvE-Malerei aus der Heldenhöhle!`;
      const m = document.getElementById('genericModal');
      m.classList.remove('opacity-0', 'pointer-events-none');
      m.classList.add('opacity-100');
    }

    function closeGenericModal() {
      const m = document.getElementById('genericModal');
      m.classList.add('opacity-0', 'pointer-events-none');
      m.classList.remove('opacity-100');
    }

    // --- INITIALIZATION ---
    window.addEventListener('DOMContentLoaded', () => {
      updateSignalfeuerUI();
      updateResourceUI();
      renderHeroes();
    });
  </script>
</body>
</html>