              <!-- 6 Stars visualization with 5-corners segment -->
              <div class="flex items-center justify-between pt-0.5">
                <div class="flex items-center gap-0.5">
                  ${renderStarRow(hero.stars, hero.corners, 12)}
                </div>
                <span class="text-[8px] font-bold text-neutral-400">${hero.stars}★ +${hero.corners}/5</span>
              </div>
            </div>

          </div>
        `;
      }).join('');
    }

    // --- HERO DETAIL MODAL ---
    function openHeroModal(heroId) {
      selectedHeroId = heroId;
